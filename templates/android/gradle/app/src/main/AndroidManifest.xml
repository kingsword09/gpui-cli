<?xml version="1.0" encoding="utf-8" ?>
<!-- NativeActivity loads the shared Rust library named by nativeLibraryName. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network / connectivity permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Vibration permission -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Notification permission (required on Android 13+ / API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Contacts permission (for contacts package) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Calendar permissions -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Microphone permission (for audio recording) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Camera permission (for image_picker camera source) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Camera feature (optional — app works without camera) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Vulkan feature declaration.
         `required="false"` allows the app to fall back to OpenGL ES on
         devices without Vulkan support. -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:required="false"
        android:version="0"
    />

    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:version="0x00401000"
    />

    <!-- GPU hardware acceleration is required for wgpu rendering. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Touchscreen support (virtually all Android devices). -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"
    />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/GpuiTheme"
    >

        <!-- The host keeps the splash visible until native initialization completes. -->
        <activity
            android:name="dev.gpui.mobile.GpuiActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@style/GpuiSplashTheme"
            android:windowSoftInputMode="adjustResize"
        >

            <!-- The native library name WITHOUT the "lib" prefix and ".so" suffix.
                 This is set via manifestPlaceholders in build.gradle.kts. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="${nativeLibraryName}"
            />

            <!-- Mark this activity as the main launcher entry point. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link intent filter for custom URL scheme -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gpui" />
            </intent-filter>
        </activity>
        <activity
            android:name="dev.gpui.mobile.GpuiPathPicker"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />
        <!-- Transparent helper Activity for file/image picker results. -->
        <activity
            android:name="dev.gpui.mobile.GpuiPickerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />

        <!-- Transparent helper Activity for runtime permission requests. -->
        <activity
            android:name="dev.gpui.mobile.GpuiPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />

        <!-- Transparent helper Activity for biometric authentication (BiometricPrompt). -->
        <activity
            android:name="dev.gpui.mobile.GpuiAuthActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />

    </application>

</manifest>
